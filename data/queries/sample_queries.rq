# 1. List all entities by class (dbo:Country) and their capitals
PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?country ?countryLabel ?capitalLabel
WHERE {
  ?country a dbo:Country ;
           rdfs:label ?countryLabel ;
           dbo:capital ?capital .
  
  OPTIONAL { ?capital rdfs:label ?capLabel }
  BIND(COALESCE(?capLabel, ?capital) AS ?capitalLabel)
}
ORDER BY ?countryLabel
LIMIT 50

# ==============================================================================

# 2. Find countries with a population greater than 50 million
PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?countryLabel ?population
WHERE {
  ?country a dbo:Country ;
           rdfs:label ?countryLabel ;
           dbo:populationTotal ?population .
  
  FILTER (?population > 50000000)
}
ORDER BY DESC(?population)

# ==============================================================================

# 3. List entities linked to English DBpedia with their abstracts
PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?countryLabel ?dbpediaLink ?abstract
WHERE {
  ?country a dbo:Country ;
           rdfs:label ?countryLabel ;
           owl:sameAs ?dbpediaLink ;
           dbo:abstract ?abstract .
           
  FILTER(CONTAINS(STR(?dbpediaLink), "dbpedia.org"))
}
LIMIT 20

