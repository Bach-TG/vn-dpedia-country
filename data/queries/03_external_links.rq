# Entities linked to other datasets (5th star): English DBpedia and Wikidata.
PREFIX dbo:  <http://dbpedia.org/ontology/>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?countryLabel ?dbpedia ?wikidata
WHERE {
  ?country a dbo:Country ;
           rdfs:label ?countryLabel .
  OPTIONAL {
    ?country owl:sameAs ?dbpedia .
    FILTER(STRSTARTS(STR(?dbpedia), "http://dbpedia.org/resource/"))
  }
  OPTIONAL {
    ?country owl:sameAs ?wikidata .
    FILTER(STRSTARTS(STR(?wikidata), "http://www.wikidata.org/entity/"))
  }
}
ORDER BY ?countryLabel
LIMIT 50
